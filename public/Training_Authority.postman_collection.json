            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{provider_token}}" }
            ],
            "url": { "raw": "{{base_url}}/provider/coaches", "host": ["{{base_url}}"], "path": ["provider", "coaches"] }
          }
        },
        {
          "name": "POST invite/create coach",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{provider_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "name", "value": "د. سارة علي" },
                { "key": "email", "value": "sara@example.com" },
                { "key": "country_code", "value": "966" },
