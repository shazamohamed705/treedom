            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{provider_token}}" }
            ],
            "url": { "raw": "{{base_url}}/provider/coaches/{{coach_id}}/resend-invitation", "host": ["{{base_url}}"], "path": ["provider", "coaches", "{{coach_id}}", "resend-invitation"] }
